# ============================================================================
# Soliva Backend — Environment (copy to `.env`; NEVER commit the real .env)
# Every value below is a PLACEHOLDER. Put real secrets in .env only.
# ============================================================================

# --- Core ---
NODE_ENV=production            # production | development  (MUST be "production" in prod)
PORT=5000

# --- Database (MongoDB) ---
MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/soliva?authSource=admin

# --- Auth / JWT ---
JWT_SECRET=replace_with_long_random_string   # used for access AND refresh tokens
OTP_EXPIRE=10                  # minutes
# NOTE: access/refresh token + cookie lifetimes are currently HARDCODED in
# utils/authUtils.js (access 15m, refresh 30d). The two vars below are
# reference-only and NOT read by the code yet — wire them up if you want them
# configurable, otherwise they can be ignored.
JWT_EXPIRE=15m                 # reference only — not read by code
COOKIE_EXPIRE=30               # days — reference only — not read by code

# --- URLs / CORS allow-list (comma-separated) ---
FRONTEND_URL=https://solivaguard.com
PUBLIC_SITE_URL=https://solivaguard.com
PUBLIC_URL=https://solivaguard.com

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me      # also set `requirepass` on the Redis server

# --- SMTP / Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username   # legacy alias: SMTP_EMAIL (code reads either)
SMTP_PASS=your_smtp_password   # legacy alias: SMTP_PASSWORD (code reads either)
SMTP_FROM=no-reply@solivaguard.com
FROM_NAME=Soliva
CONTACT_EMAIL=contact@solivaguard.com
SMTP_MAX_RETRIES=3

# --- Razorpay (REQUIRED — code throws if missing; never use mock/dummy values) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Firebase Admin (server-side ID-token verification) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Database seeding (Backend/seed.js — manual admin bootstrap, optional) ---
# If unset, seed.js falls back to dev defaults. ALWAYS set these before seeding prod.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_strong_admin_password

# --- Docker Compose only (Backend/docker-compose.yml → mongo container) ---
# Consumed at `docker compose up` for the mongo service root user + healthcheck.
# NOT read by the Node app (the app connects via MONGO_URI above). Defaults to
# admin/password if unset — override in any real deployment.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_strong_db_password

# ── MSG91 Phone OTP (SMS) ─────────────────────────────────────────────────────
# Set these to enable Phone OTP (login / registration / checkout / profile).
# Leave as placeholders to keep the feature dormant. After setting real values,
# restart the backend — no code change or frontend rebuild is required.
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_SENDER_ID=SOLIVA
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_TEMPLATE_ID
MSG91_COUNTRY_CODE=91
# Optional: template id if you use MSG91's managed OTP API instead of Flow.
# MSG91_OTP_TEMPLATE_ID=
# TEST ONLY: run the full flow but log the OTP instead of sending a real SMS.
# MSG91_MOCK=false
