# Production env — loaded by `vite build` (mode=production) and baked into the bundle.
# Frontend is served over HTTPS at https://solivaguard.com; nginx proxies /api/* to the
# backend on 127.0.0.1:5000. Use a same-origin HTTPS base so there is no mixed-content
# blocking and the session cookie is first-party. NEVER point this at localhost.
VITE_API_URL=https://solivaguard.com/api/v1
VITE_USE_MOCK_API=false
