# =============================================================================
# Soliva PRODUCTION secrets — TEMPLATE
# -----------------------------------------------------------------------------
# This file lives ONLY on the Hetzner prod box as:  /opt/soliva/.env
# It is read by docker-compose.prod.yml (env_file) and injected into containers.
# NEVER commit the real filled-in file. Copy this to `.env` on the server:
#     cp .env.prod.example .env  &&  nano .env
# =============================================================================

# --- Image registry / rollback ---
REGISTRY=ghcr.io/adi-git-hub
TAG=latest                         # set to a git SHA to pin a specific build / rollback

# --- Datastore credentials (compose builds MONGO_URI + Redis auth from these) ---
# NOTE: do NOT set MONGO_URI here — docker-compose.prod.yml constructs it from these.
MONGO_USER=solivaAdmin
MONGO_PASSWORD=CHANGE_ME_strong_random
REDIS_PASSWORD=CHANGE_ME_strong_random

# --- Backend app secrets (same keys as Backend/.env.example) ---
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRE=15m
COOKIE_EXPIRE=30                   # days
OTP_EXPIRE=10                      # minutes

FRONTEND_URL=https://solivaguard.com
PUBLIC_SITE_URL=https://solivaguard.com
PUBLIC_URL=https://solivaguard.com

# SMTP / email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@solivaguard.com
FROM_NAME=Soliva
CONTACT_EMAIL=contact@solivaguard.com
SMTP_MAX_RETRIES=3

# Razorpay (REQUIRED — app fails loud if missing; no mock fallback anymore)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Firebase Admin (server-side ID-token verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Third-party APIs
OPENWEATHER_API_KEY=your_openweather_key
WAQI_API_TOKEN=your_waqi_token
